import { type PubliChainContext, Contents, Part, PubliAction, TemplateLayout } from '@lib/publi';

export default class extends PubliAction{

  async publiAction(ctx: PubliChainContext){

    ctx.defineLayout({layout: (commonProps)=>new TemplateLayout({ ... commonProps,
      template: ({c,$,$$})=>c(['html', {lang: 'en'},
        ['head',
          ['meta', {charset: 'utf-8'}],
          $('pageTitle',{ tagName: 'title'})
        ],
        ['body',
          ['header',
            ['nav',
              ['p', $$('siteTitle')]],
            ['h1', $$('contentsTitle')],
          ],
          ['main',
            ['article', $$('contentsArticle')]],
          ['footer',
            ['nav', $$()]]
        ],
      ]),
      values: (parts: Part[], contents: Contents) => (key: string) => {
        if(key === 'pageTitle')
          return contents.title + (parts[0] ? " - " + parts[0].title : "");
        return null;
      },
      components: (parts: Part[], contents: Contents) => (key: string) => {
        const [root, ...subParts] = parts;
        return null;
      }
    })});

    await ctx.addPart({
      title: 'lieutar looper',
      components: ({F})=>({
        footer: F(
          ['address',
            ['a', { href:"https://toot.blue/@lieutar", target: "_blank" },
              '@lieutar@toot.blue']] )
      })
    });

  }
}
